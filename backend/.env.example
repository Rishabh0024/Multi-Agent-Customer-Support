# ==========================================
# Multi-Agent Customer Support Environment
# ==========================================

APP_ENV=production
DEBUG=False
PORT=8000
HOST=0.0.0.0

# ------------------------------------------
# 1. LLM Provider (Google AI Studio Free Tier)
# Get your free key at: https://aistudio.google.com/app/apikey
# ------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIzaSyYourActualGoogleAIStudioKeyHere
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# (Optional Alternative: OpenAI)
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------
# 2. PostgreSQL Database (NeonDB Free Tier)
# Get your free serverless Postgres at: https://neon.tech/
# Note: Ensure the prefix is 'postgresql+asyncpg://'
# ------------------------------------------
DATABASE_URL=postgresql+asyncpg://neondb_owner:npg_your_password@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_SYNC_URL=postgresql://neondb_owner:npg_your_password@ep-cool-fog-1234.us-east-2.aws.neon.tech/neondb?sslmode=require
SQLITE_FALLBACK=False

# ------------------------------------------
# 3. Vector Database (Qdrant Cloud Free Tier)
# Create free 1GB cluster at: https://cloud.qdrant.io/
# ------------------------------------------
QDRANT_URL=https://xyz-your-cluster-id.us-east-1.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=thIsIsYoUrQdrAntApiKeyFromCloudDashboard
QDRANT_COLLECTION_NAME=support_knowledge
QDRANT_IN_MEMORY_FALLBACK=False

# ------------------------------------------
# 4. Redis Cache & Memory (Upstash Free Tier)
# Create free Redis at: https://upstash.com/
# ------------------------------------------
REDIS_URL=rediss://default:your_upstash_password@your-endpoint.upstash.io:6379
REDIS_FALLBACK_MEMORY=False

# ------------------------------------------
# 5. Reverse Proxy, Security & CORS
# Allowed origins for your Vercel frontend
# ------------------------------------------
CORS_ORIGINS=["http://localhost:5173","https://*.vercel.app","https://multi-agent-customer-support.vercel.app"]
SENTIMENT_ESCALATION_THRESHOLD=0.35
MAX_HISTORY_TURNS=8
